// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipes {
  id                    Int                   @id @default(autoincrement())
  title                 String                @db.VarChar(255)
  cooking_time          String?               @db.VarChar(255)
  cooking_temperature   Int?                  @db.Integer
  servings              String?               @db.VarChar(255)
  mold_type             String?               @db.VarChar(255)
  mold_size             String?               @db.VarChar(255)
  image_url             String?               @db.VarChar(255)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @default(now()) @updatedAt
  deleted_at            DateTime?
  subrecipes            Subrecipes[]
  recipe_food_allergies RecipeFoodAllergies[]
}

model Ingredients {
  id           Int        @id @default(autoincrement())
  subrecipe_id Int
  name         String     @db.VarChar(255)
  amount       String?    @db.VarChar(255)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @default(now()) @updatedAt
  deleted_at   DateTime?
  subrecipe    Subrecipes @relation(fields: [subrecipe_id], references: [id])
  units        Units      @relation(fields: [unit_id], references: [id])
  unit_id      Int
}

model Subrecipes {
  id           Int           @id @default(autoincrement())
  recipe_id    Int
  title        String?       @db.VarChar(255)
  instructions String        @db.VarChar(255)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @default(now()) @updatedAt
  deleted_at   DateTime?
  recipe       Recipes       @relation(fields: [recipe_id], references: [id])
  ingredients  Ingredients[]
}

model FoodAllergies {
  id                    Int                   @id @default(autoincrement())
  name                  String                @db.VarChar(255)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @default(now()) @updatedAt
  deleted_at            DateTime?
  recipe_food_allergies RecipeFoodAllergies[]
}

model Units {
  id         Int           @id @default(autoincrement())
  name       String        @db.VarChar(255)
  created_at DateTime      @default(now())
  updated_at DateTime      @default(now()) @updatedAt
  deleted_at DateTime?
  ingredient Ingredients[]
}

model RecipeFoodAllergies {
  id              Int           @id @default(autoincrement())
  recipe_id       Int
  food_allergy_id Int
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now()) @updatedAt
  deleted_at      DateTime?
  recipe          Recipes       @relation(fields: [recipe_id], references: [id])
  food_allergy    FoodAllergies @relation(fields: [food_allergy_id], references: [id])
}
